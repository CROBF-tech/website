---
const WORDS = [
    "automatizar",
    "conectar",
    "vender",
    "modernizar",
    "digitalizar",
    "optimizar",
    "escalar",
];
---

<section class="you-can-scroll-section" aria-label="Posibilidades de trabajo con CROBF">
    <div class="you-can-scroll-content" data-you-scroll>
        <h2 class="you-can-scroll-heading" aria-hidden="true">
            <span class="prefix">Con nosotros</span>
            <span class="prefix">podés</span>
            <span class="rotator" aria-hidden="true">
                {WORDS.map((word, i) => <span class="rotator-word" data-index={i}>{word}</span>)}
            </span>
        </h2>

        <p class="sr-only">Con nosotros podés {WORDS.join(", ")}. El momento es ahora.</p>

        <p class="you-can-scroll-closing" aria-hidden="true">El momento es ahora.</p>
    </div>
</section>

<script is:inline>
    (function () {
        const root = document.querySelector("[data-you-scroll]");
        if (!root) return;

        const words = Array.from(root.querySelectorAll(".rotator-word"));
        if (words.length < 2) return;

        let index = 0;
        let intervalId = 0;
        const DURATION = 2200;

        const show = (nextIndex) => {
            words.forEach((word, i) => {
                word.classList.toggle("is-active", i === nextIndex);
                word.classList.toggle("is-prev", i === index && i !== nextIndex);
            });
            index = nextIndex;
        };

        const next = () => {
            show((index + 1) % words.length);
        };

        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        words.forEach((word, i) => word.classList.toggle("is-active", i === 0));

        if (prefersReducedMotion) return;

        intervalId = window.setInterval(next, DURATION);

        document.addEventListener("visibilitychange", () => {
            if (document.hidden) {
                if (intervalId) window.clearInterval(intervalId);
                intervalId = 0;
            } else if (!intervalId) {
                intervalId = window.setInterval(next, DURATION);
            }
        });
    })();
</script>

<style>
    .you-can-scroll-section {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        padding: clamp(4rem, 10vw, 7rem) clamp(1.2rem, 5vw, 2.6rem);
        display: grid;
        place-items: center;
        text-align: center;
        overflow: hidden;
    }

    .you-can-scroll-content {
        width: min(1120px, 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: clamp(1rem, 2.5vw, 1.8rem);
    }

    .you-can-scroll-heading {
        margin: 0;
        font-size: clamp(2rem, 7vw, 5.5rem);
        line-height: 1.05;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: rgba(16, 25, 49, 0.98);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        column-gap: 0.35em;
        row-gap: 0.15em;
    }

    :global(html.dark) .you-can-scroll-heading {
        color: rgba(255, 255, 255, 0.98);
    }

    .prefix {
        white-space: nowrap;
    }

    .rotator {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 8ch;
        height: 1.1em;
        overflow: hidden;
        font-weight: 900;
        vertical-align: bottom;
    }

    .rotator-word {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        white-space: nowrap;
        opacity: 0;
        transform: translateY(1.1em);
        transition:
            opacity 450ms cubic-bezier(0.22, 1, 0.36, 1),
            transform 550ms cubic-bezier(0.22, 1, 0.36, 1);
        background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
    }

    .rotator-word.is-active {
        opacity: 1;
        transform: translateY(0);
    }

    .rotator-word.is-prev {
        transform: translateY(-1.1em);
    }

    .you-can-scroll-closing {
        margin: 0;
        font-size: clamp(1.1rem, 2.2vw, 1.6rem);
        line-height: 1.4;
        color: rgba(23, 30, 48, 0.78);
        max-width: 36ch;
    }

    :global(html.dark) .you-can-scroll-closing {
        color: rgba(255, 255, 255, 0.72);
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }

    @media (max-width: 640px) {
        .you-can-scroll-heading {
            flex-direction: column;
            gap: 0.2em;
        }

        .rotator {
            min-width: 100%;
        }
    }
</style>
