---
import Layout from "../../../layouts/Layout.astro";
import { getLangFromUrl } from "../../../i18n/translate";

const lang = getLangFromUrl(Astro.url);
import "../../../styles/global.css";

const features = [
    { icon: "<polyline points=\"22 7 13.5 15.5 8.5 10.5 2 17\"/><polyline points=\"16 7 22 7 22 13\"/>", title: "Servicios claros", text: "Cada servicio de asesoría explicado con su alcance y para quién es, sin letra chica ni jerga financiera." },
    { icon: "<path d=\"M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z\"/><path d=\"M20 3v4\"/><path d=\"M22 5h-4\"/><path d=\"M4 17v2\"/><path d=\"M5 18H3\"/>", title: "Animaciones suaves", text: "Transiciones y reveals de scroll con Framer Motion y Lenis que acompañan la lectura sin distraer." },
    { icon: "<polyline points=\"22 7 13.5 15.5 8.5 10.5 2 17\"/><polyline points=\"16 7 22 7 22 13\"/>", title: "Gráficos interactivos", text: "Visualizaciones con Recharts que ilustran el método y hacen tangible el concepto de crecimiento patrimonial." },
    { icon: "<path d=\"M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13.1 10h7.4a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11.1 14z\"/>", title: "Carga instantánea", text: "Imágenes en formato WebP con un 92% de reducción de peso para que el sitio cargue rápido en cualquier conexión." },
    { icon: "<path d=\"M8 2v4\"/><path d=\"M16 2v4\"/><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"/><path d=\"M3 10h18\"/><path d=\"m9 16 2 2 4-4\"/>", title: "Llamado a la acción", text: "Botones para agendar un diagnóstico presentes en toda la navegación, pensados para convertir visitas en consultas." },
    { icon: "<rect width=\"14\" height=\"20\" x=\"5\" y=\"2\" rx=\"2\" ry=\"2\"/><path d=\"M12 18h.01\"/>", title: "Responsive real", text: "Layout optimizado para móvil y desktop, coherente con una audiencia que llega desde redes sociales." },
];

const stack = ["React 19", "TypeScript", "Tailwind CSS 4", "Framer Motion", "Recharts", "Vite", "Vercel"];
---

<Layout title="Financieramente Aylen - CROBF" description="Asesoramiento financiero estratégico para emprendedores argentinos, con Aylen Insaurralde - Asesora Financiera Certificada." lang={lang}>
    <main class="project-detail">
        <h1 class="project-title">FINANCIERAMENTE AYLEN</h1>

        <div class="project-info">
            <div class="info-column">
                <p class="info-label">ROLE / SERVICES</p>
                <p class="info-value">Web Design & Development</p>
            </div>
            <div class="info-column">
                <p class="info-label">LOCATION & YEAR</p>
                <p class="info-value">Argentina © 2026</p>
            </div>
        </div>

        <div class="project-actions">
            <a href="https://financieramenteaylen.vercel.app/" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                Ver en vivo
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
            </a>
        </div>

        <div class="project-image">
            <img src="/projects/financieramente.png" alt="Financieramente Aylen" />
        </div>

        <section class="project-sections">
            <div class="project-block">
                <p class="info-label">Qué es</p>
                <div class="project-block-text">
                <p>Financieramente Aylen es el sitio profesional de Aylen Insaurralde, asesora financiera certificada especializada en emprendedores y profesionales. La web presenta su método de trabajo — estructura, protección y crecimiento patrimonial —, detalla sus servicios y ofrece un canal directo para agendar un diagnóstico financiero.</p>
                <p>El diseño apuesta por tonos cálidos y una narrativa cercana: hablar de finanzas sin la frialdad típica del sector, transmitiendo que ordenar las finanzas es un camino hacia la tranquilidad y no un trámite bancario.</p>
                </div>
            </div>

            <div class="project-block">
                <p class="info-label">Cómo surgió</p>
                <div class="project-block-text">
                <p>El proyecto nació como pieza central del branding personal de Aylen: su actividad vivía dispersa en redes sociales y quería una propia casa digital que explicara su método y convirtiera visitas en consultas reales. Trabajamos la propuesta de valor alrededor de una idea que ella repite con sus clientes — tener buenos ingresos no siempre significa tener tranquilidad financiera — y la convertimos en el eje del sitio: cada sección acompaña al visitante desde el problema hasta la solución, cerrando con la invitación a agendar un diagnóstico.</p>
                </div>
            </div>

            <div class="project-block">
                <p class="info-label">Qué incluye</p>
                <div class="features-grid">
                    {features.map((feature) => (
                        <article class="feature-card">
                            <div class="feature-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <Fragment set:html={feature.icon} />
                                </svg>
                            </div>
                            <h3 class="feature-title">{feature.title}</h3>
                            <p class="feature-text">{feature.text}</p>
                        </article>
                    ))}
                </div>
            </div>

            <div class="project-block">
                <p class="info-label">Stack tecnológico</p>
                <div class="stack-row">
                    {stack.map((tech) => <span class="stack-pill">{tech}</span>)}
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .project-detail {
        width: min(1400px, calc(100% - 4rem));
        margin-inline: auto;
        padding: 8rem 2rem 5rem;
    }

    .project-title {
        font-size: clamp(3rem, 8vw, 6rem);
        font-weight: 400;
        letter-spacing: -0.02em;
        margin: 0 0 4rem 0;
        line-height: 1;
        color: hsl(var(--foreground));
    }

    .project-info {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 3rem;
        margin-bottom: 5rem;
        padding-bottom: 3rem;
        border-bottom: 1px solid hsl(var(--border));
    }

    .info-column {
        display: grid;
        gap: 1rem;
    }

    .info-label {
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: hsl(var(--foreground) / 0.5);
        margin: 0;
    }

    .info-value {
        font-size: 1.1rem;
        color: hsl(var(--foreground));
        margin: 0;
        line-height: 1.4;
    }

    .project-actions {
        margin-bottom: 3rem;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 1.75rem;
        border-radius: 2rem;
        font-size: 0.95rem;
        font-weight: 500;
        text-decoration: none;
        border: 1px solid transparent;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        transform-style: preserve-3d;
        will-change: transform;
    }

    .btn:hover {
        transform: translateY(-2px) scale(1.02);
    }

    .btn-primary {
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.03) 100%);
        color: rgba(16, 25, 49, 0.96);
        box-shadow: 
            0 10px 30px -10px rgba(0, 0, 0, 0.1),
            inset 0 1px 1px rgba(255, 255, 255, 0.1),
            inset 0 -1px 2px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }

    .btn-primary:hover,
    .btn-primary:focus,
    .btn-primary:active {
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.05) 100%);
        box-shadow: 
            0 20px 40px -10px rgba(0, 0, 0, 0.2),
            inset 0 1px 1px rgba(255, 255, 255, 0.2);
        border-color: rgba(255, 255, 255, 0.2);
        color: rgba(16, 25, 49, 0.96);
    }

    .btn-disabled {
        opacity: 0.6;
        cursor: not-allowed;
        pointer-events: none;
    }

    :global(html.dark) .btn-primary {
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.96);
    }

    :global(html.dark) .btn-primary:hover,
    :global(html.dark) .btn-primary:focus,
    :global(html.dark) .btn-primary:active {
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.03) 100%);
        border-color: rgba(255, 255, 255, 0.25);
        color: rgba(255, 255, 255, 0.96);
    }

    .project-image {
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 0.5rem;
        background: hsl(var(--muted));
    }

    .project-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    @media (max-width: 768px) {
        .project-detail {
            padding: 6rem 1.5rem 3rem;
            width: calc(100% - 2rem);
        }

        .project-title {
            margin-bottom: 2.5rem;
            font-size: clamp(2rem, 7vw, 4rem);
        }

        .project-info {
            gap: 2rem;
            margin-bottom: 3rem;
        }
    }

    @media (max-width: 480px) {
        .project-detail {
            padding: 5rem 1rem 2rem;
            width: calc(100% - 1rem);
        }

        .project-title {
            font-size: clamp(1.8rem, 8vw, 3rem);
            margin-bottom: 2rem;
        }

        .project-info {
            gap: 1.5rem;
            margin-bottom: 2rem;
            padding-bottom: 2rem;
        }

        .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<style>
    .project-sections {
        display: grid;
        gap: 4.5rem;
        margin-top: 5rem;
    }

    .project-block {
        display: grid;
        grid-template-columns: 220px minmax(0, 1fr);
        gap: 2rem;
        align-items: start;
        padding-top: 3rem;
        border-top: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    }

    .project-block .info-label {
        color: color-mix(in srgb, currentColor 50%, transparent);
        margin: 0.2rem 0 0;
    }

    .project-block-text {
        max-width: 70ch;
        display: grid;
        gap: 1rem;
    }

    .project-block-text p {
        margin: 0;
        font-size: 1.05rem;
        line-height: 1.75;
        color: color-mix(in srgb, currentColor 78%, transparent);
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1rem;
    }

    .feature-card {
        padding: 1.5rem;
        border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
        border-radius: 0.75rem;
        background: color-mix(in srgb, currentColor 3%, transparent);
        transition:
            transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
            border-color 0.35s,
            background 0.35s;
    }

    .feature-card:hover {
        transform: translateY(-3px);
        border-color: color-mix(in srgb, currentColor 28%, transparent);
        background: color-mix(in srgb, currentColor 5%, transparent);
    }

    .feature-icon {
        display: grid;
        place-items: center;
        width: 2.4rem;
        height: 2.4rem;
        border-radius: 0.6rem;
        background: color-mix(in srgb, currentColor 8%, transparent);
        margin-bottom: 1rem;
    }

    .feature-title {
        margin: 0 0 0.4rem;
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.3;
    }

    .feature-text {
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.6;
        color: color-mix(in srgb, currentColor 68%, transparent);
    }

    .stack-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .stack-pill {
        font-size: 0.8rem;
        letter-spacing: 0.02em;
        padding: 0.4rem 1rem;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, currentColor 15%, transparent);
        background: color-mix(in srgb, currentColor 3%, transparent);
    }

    @media (max-width: 768px) {
        .project-sections {
            gap: 3rem;
            margin-top: 3.5rem;
        }

        .project-block {
            grid-template-columns: 1fr;
            gap: 1.25rem;
            padding-top: 2rem;
        }
    }
</style>
